---
import "../styles/global.css";
interface Props {
    pageTitle: string
}
const {pageTitle} = Astro.props;
---

<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <title>{pageTitle}</title>
</head>
<body>

<header>
    <slot name="header"/>
</header>
<slot/>

<footer>
    <slot name="footer"/>
</footer>
</body>
</html>
