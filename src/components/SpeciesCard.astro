---
import "../styles/card.css";
import ThreatBadge from "./ThreatBadge.astro";
import type {Species} from "../data/species";

interface Props {
    species: Species
}
const {species} = Astro.props;
---
<a href={`/species/${species.id}`} class="card">
    <div class="card-icon">
        {species.icon}
    </div>
    <div class="card-body">
        <div class="card-name">
            {species.name}
        </div>
        <div class="card-scientific">
            {species.scientificName}
        </div>
        <span class="card-island">{species.island}</span>
        <ThreatBadge threatLevel={species.threat}/>
    </div>
</a>