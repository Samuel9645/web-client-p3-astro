---
import "../styles/species-card.css";
import ThreatBadge from "./ThreatBadge.astro";
import type {Species} from "../data/species";
import Card from "./Card.astro";
import {Image} from 'astro:assets';

interface Props {
    species: Species
}
const {species} = Astro.props;
---
<a href={`/species/${species.id}`} class="card">
    <Card>
        <Image
                slot="icon"
                src={species.imageMetadata}
                alt={species.name}
                class="card-icon"
        />
        <div class="card-name" slot="title">{species.name}</div>
        <div class="card-scientific">
            {species.scientificName}
        </div>
        <span class="card-island">{species.islands.join(", ")}</span>
        <ThreatBadge threatLevel={species.threat}/>
    </Card>
</a>

<style>
    :global(.card-icon-img) {
        display: block;
        margin: 0 auto; /* Centra horizontalmente */
        max-height: 100%;
        object-fit: contain;
    }
</style>