---
import {SPECIES} from "../data/species";
import SpeciesCard from "../components/SpeciesCard.astro";
import BaseLayout from "../components/BaseLayout.astro";
---

<BaseLayout pageTitle="Ejercicio Astro — Especies de Canarias">
    <h1>🌿 Catálogo de Especies Endémicas de Canarias</h1>
    <p class="subtitle">Ejercicio de Astro — haz clic en una especie para
        ver el detalle</p>

    <div class="catalog">
        {SPECIES.map((species) => (
                <SpeciesCard species={species}/>
        ))}
    </div>
</BaseLayout>
