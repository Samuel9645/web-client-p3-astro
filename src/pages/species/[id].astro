---
import "../../styles/detail.css";
import {allSpecies, type Species} from "../../data/species";
import BaseLayout from "../../components/BaseLayout.astro";
import ThreatBadge from "../../components/ThreatBadge.astro";
import Chip from "../../components/Chip.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Image from "astro/components/Image.astro";

export async function getStaticPaths() {
    return allSpecies.map((species) => ({
        params: {id: species.id}, props: {species},
    }));
}

interface Props {
    species: Species;
}

const {species} = Astro.props;
---
<BaseLayout pageTitle={species.name}>
    <Breadcrumb baseRoute="Catálogo" baseUrl="/" currentRoute={species.name}
                slot="header"/>
    <div class="detail">
        <a href="/" class="close-button" type="button">✕ cerrar
        </a>
        <div class="detail-header">
            <span class="detail-icon">{species.icon}</span>
            <div>
                <div class="detail-name">{species.name}</div>
                <div class="detail-scientific">{species.scientificName}</div>
            </div>
        </div>
        <p class="detail-description">{species.description}</p>
        <div class="detail-meta">
            {[
                `🏝 ${species.islands.join(", ")}`,
                `🌲 ${species.habitat}`,
                `📏 ${species.height}`,
            ].map((item) =>
                    <Chip>{item}</Chip>)}
            <ThreatBadge threatLevel={species.threat}/>
        </div>

        <Image src={species.imageMetadata} alt={species.name}
               class="detail-image"/>
    </div>
</BaseLayout>
